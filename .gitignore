# Dependencies
node_modules/
.pnpm-store/

# pnpm writes a self-referential lockfile at the repo root; this project has no
# installed dependencies.
/pnpm-lock.yaml

# Local toolchain (portable Hugo binary downloaded for this machine) and caches
.tools/
.cache/

# Build output — never commit generated files
hugo/public/
hugo/resources/
hugo/.hugo_build.lock
hugo/content-en/

# Logs and OS noise
*.log
.DS_Store
Thumbs.db
